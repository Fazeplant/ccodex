FROM docker.io/library/node:22-bookworm

ARG E2E_UID=1000
ARG E2E_GID=1000
ARG MAIN_TGZ
ARG RELAY_TGZ
ARG CCODEX_VERSION

RUN test "$(id -u node)" = "${E2E_UID}" \
 && test "$(id -g node)" = "${E2E_GID}" \
 && usermod --login e2e --home /opt/e2e-home --move-home node \
 && groupmod --new-name e2e node \
 && mkdir -p /opt/e2e /tmp/packages \
 && chown -R e2e:e2e /opt/e2e-home /opt/e2e /tmp/packages

COPY --chown=e2e:e2e ${MAIN_TGZ} /tmp/packages/main.tgz
COPY --chown=e2e:e2e ${RELAY_TGZ} /tmp/packages/relay.tgz

USER e2e
ENV HOME=/opt/e2e-home \
    CCODEX_HOME=/opt/e2e-home/.ccodex \
    CODEX_HOME=/opt/e2e-home/.codex \
    CLAUDE_CONFIG_DIR=/opt/e2e-home/.claude \
    PATH=/opt/e2e-home/.ccodex/bin:/opt/e2e-home/stage/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    CCODEX_RPC_CAPTURE=0 \
    CCODEX_LOG_PROMPTS=0 \
    CCODEX_DEBUG_CAPTURE=0

# This is the same staged hand-off used by scripts/install.sh. Installing the relay
# tarball in the same npm transaction keeps the dev build wholly local while npm
# still resolves the main package's ordinary dependencies and pinned Codex runtime.
RUN mkdir -p /opt/e2e-home/.codex /opt/e2e-home/.claude/projects \
 && npm install --prefix /opt/e2e-home/stage --include=optional --ignore-scripts --save=false \
      /tmp/packages/main.tgz /tmp/packages/relay.tgz \
 && /opt/e2e-home/stage/node_modules/.bin/ccodex setup \
      --staged /opt/e2e-home/stage --version "${CCODEX_VERSION}" \
 && /opt/e2e-home/.ccodex/bin/ccodex --version \
 && rm -f /tmp/packages/main.tgz /tmp/packages/relay.tgz

USER root
COPY --chown=e2e:e2e lib /opt/e2e/lib
COPY --chown=e2e:e2e scenarios /opt/e2e/scenarios
COPY --chown=e2e:e2e report.mjs /opt/e2e/report.mjs
COPY --chown=e2e:e2e prepare.mjs /opt/e2e/prepare.mjs
RUN mkdir -p /work && chown e2e:e2e /work
USER e2e
WORKDIR /work
